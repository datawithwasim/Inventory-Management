APP_NAME="Home Furnishing Inventory"
APP_ENV=local
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventory_dev
DB_USER=inv
DB_PASS=inv

# The company and its first owner (used by database/seed.php on a fresh install; the web installer asks for them instead)
COMPANY_NAME="My Company"
OWNER_NAME="Owner"
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=ChangeMe123!
# Only when turning an older multi-company database into one company: the id of the company to keep
# (else the company of the owner who presses Settings → Updates & backup → Run updates is kept).
# KEEP_COMPANY_ID=
MAIL_DRIVER=log

# Keep the classic (non-app) screens reachable. Leave this OUT on the live site: the app (/app) is the interface.
# LEGACY_UI=1
